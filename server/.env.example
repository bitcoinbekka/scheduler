# Copy to .env and adjust for your deployment.

# Port the server listens on.
PORT=8080

# Directory where the SQLite database is stored.
DATA_DIR=./data

# Secret protecting the optional manual cron trigger:
#   GET /?action=cron&key=YOUR_CRON_SECRET
# The server publishes due events automatically on an internal timer, so this
# is only needed if you want an external trigger too. Set a strong random value.
CRON_SECRET=

# How often (in milliseconds) to check for and publish due events.
CHECK_MS=60000

# Required to accept Amber/NIP-46 fire-time jobs. Encrypts bunker URIs at rest.
# Any passphrase; hashed to a 32-byte key. Never commit the real value.
BUNKER_STORE_KEY=
